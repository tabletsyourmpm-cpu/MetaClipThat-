<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Playful light theme off the "M Clip that!" logo. Freckle Face for
         headings/buttons/display text; system sans for body text. -->
    <style name="Theme.MetaClipThat" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/melon_accent</item>
        <item name="colorOnPrimary">@color/melon_on_accent</item>
        <item name="colorPrimaryContainer">@color/melon_accent_dark</item>
        <item name="colorOnPrimaryContainer">@color/melon_on_accent</item>
        <item name="colorSecondary">@color/melon_accent_dark</item>
        <item name="colorOnSecondary">@color/melon_on_accent</item>
        <item name="android:windowBackground">@color/cream_bg</item>
        <item name="colorSurface">@color/cream_card</item>
        <item name="colorOnSurface">@color/charcoal</item>
        <item name="colorSurfaceVariant">@color/cream_deep</item>
        <item name="colorOnSurfaceVariant">@color/charcoal2</item>
        <item name="android:textColorPrimary">@color/charcoal</item>
        <item name="android:textColorSecondary">@color/charcoal2</item>
        <item name="bottomNavigationStyle">@style/Widget.MetaClipThat.BottomNav</item>
    </style>

    <style name="Widget.MetaClipThat.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.MetaClipThat.BottomNav</item>
    </style>

    <style name="ThemeOverlay.MetaClipThat.BottomNav" parent="">
        <item name="colorSurface">@color/cream_card</item>
    </style>

    <!-- Melon pill buttons with the hand-drawn display font. -->
    <style name="Widget.MetaClipThat.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/melon_accent</item>
        <item name="android:textColor">@color/melon_on_accent</item>
        <item name="android:fontFamily">@font/freckle_face</item>
    </style>

    <!-- The big Medal-style clip button. -->
    <style name="Widget.MetaClipThat.Button.BigClip" parent="Widget.Material3.Button">
        <item name="cornerRadius">32dp</item>
        <item name="backgroundTint">@color/melon_accent</item>
        <item name="android:textColor">@color/melon_on_accent</item>
        <item name="android:fontFamily">@font/freckle_face</item>
    </style>

    <style name="Text.MetaClipThat.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:fontFamily">@font/freckle_face</item>
    </style>

    <style name="Text.MetaClipThat.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:fontFamily">@font/freckle_face</item>
    </style>

    <style name="Text.MetaClipThat.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/charcoal</item>
        <item name="android:fontFamily">@font/freckle_face</item>
    </style>

    <!-- Fullscreen black splash host; stage artwork paints the background. -->
    <style name="Theme.MetaClipThat.Splash" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
